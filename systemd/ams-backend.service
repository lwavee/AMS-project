[Unit]
Description=AMS Enterprise FastAPI Backend Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/AMS-project/backend
ExecStart=/var/www/AMS-project/backend/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 2
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
StandardOutput=append:/var/log/ams-backend.log
StandardError=append:/var/log/ams-backend-error.log

[Install]
WantedBy=multi-user.target
