[Unit]
Description=AMS Enterprise Next.js Frontend Service
After=network.target ams-backend.service

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/AMS-project/frontend
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=3
Environment=NODE_ENV=production
Environment=PORT=3000
StandardOutput=append:/var/log/ams-frontend.log
StandardError=append:/var/log/ams-frontend-error.log

[Install]
WantedBy=multi-user.target
