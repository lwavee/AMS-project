# Database connection URL for PostgreSQL
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_SUPABASE_PROJECT.supabase.co:5432/postgres

# The name of the application
APP_NAME=AMS360

# The current running environment (development, staging, production)
APP_ENV=development

# Enables or disables debug mode (True/False)
DEBUG=True

# Application URLs & CORS
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Application Secret Key
SECRET_KEY=your-super-secret-key

# Invitation Expiration (in minutes, 1440 = 24 hours)
INVITATION_TOKEN_EXPIRE_MINUTES=1440

# Microsoft 365 / Outlook OAuth 2.0 Integration (Task 5 & 7)
# Must match your Microsoft Entra ID App Registration
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=organizations
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/agency/mail/oauth/callback

# Symmetric Key for Token Encryption at Rest (32-byte urlsafe base64 key or passphrase)
TOKEN_ENCRYPTION_KEY=
