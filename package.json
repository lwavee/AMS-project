{
    "name": "ams-project",
    "version": "1.0.0",
    "private": true,
    "workspaces": [
        "frontend"
    ],
    "scripts": {
        "frontend": "npm run dev --prefix frontend",
        "backend": "cd backend && venv\\Scripts\\uvicorn app.main:app --reload",
        "build": "npm run build --prefix frontend",
        "dev": "concurrently --names \"NEXT,FASTAPI\" --prefix-colors \"cyan,magenta\" \"npm run frontend\" \"npm run backend\""
    },
    "devDependencies": {
        "concurrently": "^9.0.0"
    }
}